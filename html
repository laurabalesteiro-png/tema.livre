    <!-- COMO COMBATER -->
    <section id="combater" class="section section-gradient">

        <p class="titulo-pequeno">FAÇA A DIFERENÇA</p>

        <h2>Como podemos combater a homofobia?</h2>

        <div class="passos">

            <div class="passo">
                <span>01</span>
                <h3>Informe-se</h3>
                <p>
                    Conhecimento ajuda a combater preconceitos
                    e desinformação.
                </p>
            </div>

            <div class="passo">
                <span>02</span>
                <h3>Respeite</h3>
                <p>
                    Todas as pessoas merecem ser tratadas
                    com dignidade.
                </p>
            </div>

            <div class="passo">
                <span>03</span>
                <h3>Não normalize</h3>
                <p>
                    Piadas e comentários preconceituosos
                    também podem causar danos.
                </p>
            </div>

            <div class="passo">
                <span>04</span>
                <h3>Denuncie</h3>
                <p>
                    Violações de direitos humanos podem ser
                    denunciadas aos canais oficiais.
                </p>
            </div>

        </div>

    </section>


    <!-- QUIZ -->
    <section id="quiz" class="section quiz">

